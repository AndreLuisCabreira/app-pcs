# Exemplo sem credenciais. Copie para .env.local no desenvolvimento ou .env no pacote.
# Preencha DB_PASSWORD antes de executar. Nunca publique arquivos configurados.
# MariaDB/MySQL local:
DB_URL=jdbc:mysql://localhost:3306/pcbuilder?useSSL=false&serverTimezone=UTC
DB_USER=pcbuilder
DB_PASSWORD=
DB_ALLOW_EMPTY_PASSWORD=false

# Alternativa PostgreSQL/Supabase: substitua DB_URL e DB_USER acima.
# DB_URL=jdbc:postgresql://HOST_DO_POOLER:5432/postgres?sslmode=require
# DB_USER=postgres.PROJECT_REF

# Opcionais: valores padrão do pool JDBC.
DB_POOL_SIZE=4
DB_CONNECTION_TIMEOUT_MS=10000
